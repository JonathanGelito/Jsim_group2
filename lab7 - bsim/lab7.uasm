|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
| Fibonacci Sequence

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

.include beta.uasm          | include the standard predefined macros

    | Initialization
        LD(r31, INPUT, r0)  | r0 = memory[r31 + INPUT] (the array length)
        CMOVE(0, r1)        | r1 = 0 (byte offset for Fibonacci entry)
        CMOVE(0, r2)        | r2 = 0 (Current fibonacci term, F_0)
        CMOVE(1, r3)        | r1 = 1 (Next Fibonacci term, F_1)

    | Main Loop
LOOP:   
        CMPLEC(r0, 0, r5)   | r5 = (r0 <= 0) ? 1 : 0
        BNE(r5, DONE)       | if r0 <= 0 (r5 != 0), branch to DONE

        ST(r2, FIBO, r1)    | Mem[FIBO + r1] = r2 (store current term)

        ADD(r2, r3, r4)     | r4 = r2 + r3 (compute next term)
        MOVE(r3, r2)        | r2 = r3 (advance current term)
        MOVE(r4, r3)        | r3 = r4 (advance next term)

        ADDC(r1, 4, r1)     | r1 = r1 + 4 (advance byte offset by 1 word)
        SUBC(r0, 1, r0)     | r0 = r0 - 1 (decrement remaining counter)
        BR(LOOP)            | Repeat loop

DONE:
        HALT()              | Stop the program

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
| Data Section
|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
. = 0x19C                       | Place data block at memory address 0x19C

INPUT:
        LONG(7)                 | N: number of Fibonacci terms to generate

FIBO:                           | Output block where terms will be written

| The "." statement changes the current memory location of any succeeding
| UASM macros, so that it is easy to locate in the BSim window.
| - If you omit this statement, the INPUT memory block would begin directly
|   after your program block.
| - You may need to adjust this memory location to make more memory space for
|   your data.
. = 0x19C

| INPUT marks the beginning of the memory block containing the hardcoded
| user "input".
INPUT:
        LONG(5)             | <-- length of the array
        LONG(4)             | <-- first element of the array
        LONG(2)
        LONG(0)
        LONG(6)
        LONG(-9)            | <-- last element of the array

| OUTPUT marks the memory block where the output will appear.
| Nothing follows the label because the output will be written by the program.
OUTPUT:
