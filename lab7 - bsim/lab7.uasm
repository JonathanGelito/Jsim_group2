| Lab 7: BSIM
| Problem 1: Sum of odd and even numbers
| 
| Group 2:
| Cabalteja, Pierce Johan
| Caintic, Elijah Emmanuel
| Gelito II, Jonathan
| 

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

.include beta.uasm              | include the standard predefined macros

        LD(r31, INPUT, r0)      | r0 = memory[r31 + INPUT] (the array length)

CHECK_NUM:                      
        ADDC(r1, 4, r1)         | r1 = r1 + 4
        LD(r1, INPUT, r2)       | r2 = memory[r1 + INPUT] (r2 contains the current number to be added)
        ANDC(r2, 1, r3)         | r3 = r2 & 1 (Perform bitwise AND between r2 and 1)

        BT(r3, ODD_LOOP)        | If r3 = 1, the number is odd and branches to the ODD_LOOP
        BF(r3, EVEN_LOOP)       | If r3 = 0, the number is even and branches to the EVEN_LOOP

CHECK_LOOP:
        BNE(r0, CHECK_NUM)      | If r0 (the array counter) != 0, branch to CHECK_NUM
        BR(DONE)                | Otherwise, branch to DONE

ODD_LOOP:
        ADD(r4, r2, r4)         | r4 = r4 + r2 (Keep a running total in r4)
        BR(COUNTER)             | Branch to COUNTER
   
EVEN_LOOP:
        ADD(r5, r2, r5)         | r5 = r5 + r2 (Keep a running total in r5)
        BR(COUNTER)             | Branch to COUNTER

COUNTER:
        SUBC(r0, 1, r0)         | r0 = r0 - 1 (Decrement the array counter)
        BR(CHECK_LOOP)          | Branch to CHECK_LOOP

DONE:
        ST(r4, ODDSUM)          | Store r4 into memory [ODDSUM + r31]
        ST(r5, EVENSUM+4)       | Store r5 into memory [EVENSUM + 4 + r31]
        HALT()                  | Finish execution


|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

| The "." statement changes the current memory location of any succeeding
| UASM macros, so that it is easy to locate in the BSim window.
| - If you omit this statement, the INPUT memory block would begin directly
|   after your program block.
| - You may need to adjust this memory location to make more memory space for
|   your data.
. = 0x19C

| INPUT marks the beginning of the memory block containing the hardcoded
| user "input".
INPUT:
        LONG(7)
        LONG(5)
        LONG(7)
        LONG(8)
        LONG(6)
        LONG(4)
        LONG(9)
        LONG(3)

| OUTPUT marks the memory block where the output will appear.
| Nothing follows the label because the output will be written by the program.
ODDSUM:

EVENSUM:
